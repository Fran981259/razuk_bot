# ==============================================================================
# BOT DE TRADING QUANTITATIVO - VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA comite o arquivo .env preenchido no repositório de código.
# ==============================================================================

# --- CONEXAO (IQ OPTION) ---
# Você pode usar IQ_EMAIL/IQ_PASSWORD ou API_KEY/API_SECRET — ambos são suportados.
# Preencha IQ_SSID para login via sessão sem precisar de senha (evita bloqueios 2FA).
API_KEY=seu_email@iqoption.com
API_SECRET=sua_senha_segura
IQ_SSID=           # Opcional: token de sessão pré-autenticada
ACCOUNT_TYPE=PRACTICE  # "PRACTICE" (demo) ou "REAL" (conta real)
CORRETORA_URL=https://auth.iqoption.com/api/v2/login
WS_URL=wss://iqoption.com/echo/websocket

# --- TRADING ---
# TIMEFRAME: Período das velas ("M1" ou "M5")
TIMEFRAME=M1
# EXPIRATION_MINUTES: Tempo de expiração da ordem em minutos (1 ou 5)
EXPIRATION_MINUTES=1
# PARES_MOEDAS: Lista JSON ou CSV de ativos a monitorar
PARES_MOEDAS=["EURUSD", "GBPUSD", "USDJPY", "AUDUSD"]

# --- ESTRATEGIA ---
# Hierarquia obrigatória: EMA_FAST < EMA_MED < EMA_SLOW < EMA_DIST
EMA_FAST=9
EMA_MED=21
EMA_SLOW=50
EMA_DIST=80
EMA_SIG=5

# ADX: qualificador de força e regime de mercado
# ADX > ADX_TREND_THRESHOLD  → tendência confirmada
# ADX < ADX_RANGE_THRESHOLD  → mercado em range (consolidação)
ADX_PERIOD=14
ADX_TREND_THRESHOLD=25.0
ADX_RANGE_THRESHOLD=20.0

# Indicadores de Volatilidade
ATR_PERIOD=20
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0

# TMZ Vol V2: limiares percentuais de volume entre as 3 velas de exaustão
# Vela 3 (expansão máxima) → Vela 2 (perda de força) → Vela 1 (exaustão)
TMZ_V3_MIN=80.0
TMZ_V3_MAX=100.0
TMZ_V2_MIN=60.0
TMZ_V2_MAX=80.0
TMZ_V1_MIN=35.0
TMZ_V1_MAX=50.0

# Filtro de Pavio / Indecisão (descarte de pares com ruído excessivo)
MAX_PAVIO_TOTAL=0.65       # Pavio total máximo na vela (0.65 = 65% da vela)
MAX_PAVIO_REJEICAO=0.40    # Pavio de rejeição contrário ao sinal (0.40 = 40%)

# --- MACHINE_LEARNING ---
# Probabilidade mínima P(Win) exigida para abrir uma entrada (entre 0.50 e 0.95)
ML_THRESHOLD=0.70
MODEL_PATH=models/lgbm_model.joblib

# --- GESTAO_RISCO ---
# Capital base da conta — defina 0.0 para puxar o saldo REAL automaticamente da corretora
BANCA_INICIAL=0.0
# Valor fixo da ordem em USD (ex: 2.00 para modo treino/aprendizado, ou 0.0 para usar Kelly)
STAKE_FIXA=2.00
# Risco fixo máximo por entrada (ex: 0.01 = 1%)
RISK_PER_TRADE_PCT=0.01
# Fração conservadora do Critério de Kelly (entre 0.05 e 0.50)
KELLY_FRACTION=0.15
# Stop loss diário — bloqueio automático (padrão 0.40 = 40% para suportar ciclo de Martingale de 2 níveis)
MAX_DAILY_DRAWDOWN_PCT=0.40
# Quantidade de derrotas consecutivas antes de acionar o cooldown
MAX_CONSECUTIVE_LOSSES=3
# Pausa em minutos após atingir o limite de losses consecutivos
COOLDOWN_MINUTES_AFTER_LOSS_STREAK=60

# --- MINI ESTRATÉGIA MARTINGALE ---
# Ativar recuperação Martingale (True/False)
MARTINGALE_ENABLED=True
# Mão inicial: percentual do capital da banca (0.05 = 5%)
MARTINGALE_BASE_PCT=0.05
# Máximo de níveis de recuperação (2 = Gale 1 e Gale 2)
MARTINGALE_MAX_LEVELS=2
# Multiplicador do lote após derrota (2.2x para cobrir payout e obter lucro)
MARTINGALE_MULTIPLIER=2.2
# Repetir mesma direção da entrada anterior (True/False)
MARTINGALE_SAME_DIRECTION=True
