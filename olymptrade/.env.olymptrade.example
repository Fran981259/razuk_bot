# ==============================================================================
# CONFIGURAÇÕES OLYMP TRADE (.env.olymptrade.example)
# ==============================================================================

# Token de sessão capturado do navegador (F12 -> Network -> WS)
OLYMP_TOKEN=seu_token_aqui

# Tipo de conta: PRACTICE (demo) ou REAL (live)
OLYMP_ACCOUNT_TYPE=PRACTICE

# Timeframe das velas para a estratégia (M1, M5, M15)
OLYMP_TIMEFRAME=M5

# Expiração da ordem FTT em minutos
OLYMP_EXPIRATION_MINUTES=5

# Lista de pares monitorados
OLYMP_PARES=EURUSD,GBPUSD,USDJPY,AUDUSD,EURJPY
